@if (Model.Type == 0)
{
    <component type="typeof(SQLChecker.Components.AdminUsers)" render-mode="Server" param-ViewModel="Model"/>
}
else if (Model.Type == 1)
{
    <component type="typeof(SQLChecker.Components.AdminCourses)" render-mode="Server" param-ViewModel="Model" />
}
else if (Model.Type == 2)
{
    <component type="typeof(SQLChecker.Components.AdminAssignments)" render-mode="Server" param-ViewModel="Model" />
}
else if (Model.Type == 3)
{
    <component type="typeof(SQLChecker.Components.AdminTasks)" render-mode="Server" param-ViewModel="Model" />
}
else if (Model.Type == 4)
{
    <component type="typeof(SQLChecker.Components.AdminDatabase)" render-mode="Server" param-ViewModel="Model" />
}

