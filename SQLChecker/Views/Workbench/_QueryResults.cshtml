@model SQLChecker.Models.ViewModels.QueryResultViewModel

@if (Model.HasError)
{
    <div class="wb-results-error">
        Virhe: @Model.Error
    </div>
}
else if (!Model.HasRows)
{
    <div class="wb-results-empty">Kysely suoritettu — ei tuloksia</div>
}
else
{
    <div id="query-result" data-rowcount="@Model.Rows.Count">

        <table>
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>

    </div>
}