<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="utf-8" />
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="Server" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQLChecker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SQLChecker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
</head>
<body>
    <header class="layout-main-header">
        <nav class="navbar navbar-expand-sm navbar-light bg-white">
            <div class="container-fluid layout-main-nav-content">

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="navbar-collapse collapse d-sm-inline-flex nav-link-container">
                    <ul class="navbar-nav">
                        <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Home" asp-action="Index">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Koti
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Admin" asp-action="Users">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-shield-lock"></i> Käyttäjät
                                </a>
                            </li>
                            <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Admin" asp-action="Courses">
                                <a class="nav-link" asp-controller="Admin" asp-action="Courses">
                                    <i class="bi bi-book"></i> Kurssit
                                </a>
                            </li>
                            <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Admin" asp-action="Assignments">
                                <a class="nav-link" asp-controller="Admin" asp-action="Assignments">
                                    <i class="bi bi-collection"></i> Tehtävä kokonaisuudet
                                </a>
                            </li>
                            <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Admin" asp-action="Tasks">
                                <a class="nav-link" asp-controller="Admin" asp-action="Tasks">
                                    <i class="bi bi-list"></i> Tehtävät
                                </a>
                            </li>
                            <li class="nav-item" is-active-route active-class="main-nav-active" asp-controller="Admin" asp-action="Databases">
                                <a class="nav-link" asp-controller="Admin" asp-action="Databases">
                                    <i class="bi bi-database"></i> Tietokannat
                                </a>
                            </li>
                        }

                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-person-circle fs-4 me-2"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Settings">
                                            <button type="submit" class="mwn-item dropdown-link-btn d-flex align-items-center text-start w-100">
                                                <i class="bi bi-gear me-2"></i> Asetukset
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-controller="Login" asp-action="Logout">                                            
                                            <button type="submit" class="mwn-item dropdown-link-btn d-flex align-items-center text-start w-100">
                                                <i class="bi bi-box-arrow-right me-2"></i> Kirjaudu ulos
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SQLChecker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <base href="~/" />
    <script src="_framework/blazor.server.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_Toasts")
</body>
</html>
