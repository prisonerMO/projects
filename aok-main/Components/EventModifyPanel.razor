	private void SelectPicture(string pic)
	{
		ViewModel.Event.TitleImageUrl = pic;
	}
	private void LoadPictures()
	{
		var imagesPath = Path.Combine(WebHostEnvironment.ContentRootPath, "Protected", "Events");
		if (Directory.Exists(imagesPath))
		{
			var files = Directory.GetFiles(imagesPath)
				.Select(f => Path.GetFileName(f))
				.Where(f => f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase))
				.ToList();

			ViewModel.Pictures = files;
		}
		else
		{
			ViewModel.Pictures = new List<string>();
		}
	}
	private string uploadedImageUrl;
	private const int MaxImageSizeInBytes = 250 * 1024;
	private async Task HandleImageSelected(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file.Size > MaxImageSizeInBytes)
		{
			return;
		}
		if (Path.GetExtension(file.Name).ToLower() != ".jpg")
		{
			return;
		}
		var uniqueFileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
		var uploadPath = Path.Combine(WebHostEnvironment.ContentRootPath, "Protected", "Events");
		Directory.CreateDirectory(uploadPath);
		var filePath = Path.Combine(uploadPath, uniqueFileName);
		using (var fileStream = new FileStream(filePath, FileMode.Create))
		{
			await file.OpenReadStream().CopyToAsync(fileStream);
		}
		uploadedImageUrl = uniqueFileName;
		ViewModel.Event.TitleImageUrl = uploadedImageUrl;
		StateHasChanged();
	}

	private void DeleteTitlePicture()
	{
		ViewModel.Event.TitleImageUrl = "";
		try
		{
			if (!string.IsNullOrEmpty(uploadedImageUrl))
			{
				var uploadFolder = Path.Combine(WebHostEnvironment.ContentRootPath, "Protected", "Events");
				var fullPath = Path.Combine(uploadFolder, uploadedImageUrl);

				if (File.Exists(fullPath))
				{
					File.Delete(fullPath);
				}

				uploadedImageUrl = "";
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error deleting picture: {ex.Message}");
		}
	}



	private async Task HandleModsSelected(InputFileChangeEventArgs e)
	{
		var file = e.File;

		if (file.Size > MaxImageSizeInBytes)
		{
			return;
		}
		if (Path.GetExtension(file.Name).ToLower() != ".html")
		{
			return;
		}
		var originalName = Path.GetFileNameWithoutExtension(file.Name);
		var dateSuffix = DateTime.Now.ToString("ddMMyy");
		var newFileName = $"{originalName}-{dateSuffix}.html";
		var uploadPath = Path.Combine(WebHostEnvironment.ContentRootPath, "Protected", "ModLists");
		Directory.CreateDirectory(uploadPath);
		var filePath = Path.Combine(uploadPath, newFileName);
		using (var fileStream = new FileStream(filePath, FileMode.Create))
		{
			await file.OpenReadStream().CopyToAsync(fileStream);
		}
		ViewModel.Event.ModPreset = newFileName;
		StateHasChanged();
	}

