@using AOK.Models
@using AOK.Models.Services
@using MongoDB.Bson
@using AOK.ViewModels
@using Microsoft.AspNetCore.Components.Web
<PageTitle>AOK - Palvelimet</PageTitle>

<div class="event-panel-header-container ">
	<div class="event-panel-headers">
		<h3>Peli palvelimien hallinta</h3>
	</div>
</div>
@if (ViewModel.GameServers == null)
{
	<p class="aok-nav-text-normal ">Ladataan peli palvelimia...</p>
}
else
{
	<div class="event-tss-container">

		<div class="event-tss-content">
			@if (ViewModel.GameServers.Count > 0)
			{
				<table class="event-tss-panel">
					<thead>
						<tr>
							<th>Nimi</th>
							<th>Osoite</th>
							<th>Portti</th>
							<th>Salasana</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var server in ViewModel.GameServers)
						{
							if (server.Name != "Tyhjä")
							{
								<tr style="cursor: pointer;" @onclick="() => OpenEditModal(server)">
									<td>@server.Name</td>
									<td>@server.IP</td>
									<td>@server.Port</td>
									<td>@server.Password</td>
								</tr>
							}
						}
					</tbody>
				</table>
			}
			else
			{
				<p class="aok-nav-text-normal aok-no-content">Peli palvelimia ei löytynyt.</p>
			}
			<div class="event-panel-create-cont@(ViewModel.GameServers.Count > 0 ? "" : "-left")">
				<button class="event-btn-create" @onclick="OpenGameServerModal">+ Luo palvelin</button>
			</div>
		</div>
	</div>

	<div class="modal fade @(IsGameServerModalOpen ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Luo uusi Peli Server</h5>
					<button type="button" class="btn-close" @onclick="CloseGameServerModal"></button>
				</div>
				<div class="modal-body">
					<EditForm Model="NewGameServer" OnValidSubmit="CreateGameServer">
						<DataAnnotationsValidator />
						<ValidationSummary />

						<div>
							<label for="gs-name">Nimi</label>
							<InputText id="gs-name" class="form-control" @bind-Value="NewGameServer.Name" />
						</div>

						<div>
							<label for="gs-ip">Osoite</label>
							<InputText id="gs-ip" class="form-control" @bind-Value="NewGameServer.IP" />
						</div>

						<div>
							<label for="gs-port">Portti</label>
							<InputNumber id="gs-port" class="form-control" @bind-Value="NewGameServer.Port" />
						</div>

						<div>
							<label for="gs-password">Salasana</label>
							<InputText id="gs-password" class="form-control" @bind-Value="NewGameServer.Password" />
						</div>

						<div class="modal-footer">
							<button type="button" class="event-btn-cancel" @onclick="CloseGameServerModal">Peruuta</button>
							<button type="submit" class="event-btn-create">Luo</button>
						</div>
					</EditForm>
				</div>
			</div>
		</div>
	</div>

	@if (IsEditModalOpen && SelectedGameServer != null)
	{
		<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Muokkaa peli serveriä: @SelectedGameServer?.Name</h5>
						<button type="button" class="btn-close" @onclick="CloseEditModal"></button>
					</div>
					<div class="modal-body">
						<div class="mb-3">
							<label for="edit-name">Nimi</label>
							<InputText id="edit-name" class="form-control" @bind-Value="SelectedGameServer.Name" />
						</div>
						<div class="mb-3">
							<label for="edit-ip">Osoite</label>
							<InputText id="edit-ip" class="form-control" @bind-Value="SelectedGameServer.IP" />
						</div>
						<div class="mb-3">
							<label for="edit-port">Portti</label>
							<InputNumber id="edit-port" class="form-control" @bind-Value="SelectedGameServer.Port" />
						</div>
						<div class="mb-3">
							<label for="edit-password">Salasana</label>
							<InputText id="edit-password" class="form-control" @bind-Value="SelectedGameServer.Password" />
						</div>
					</div>
					<div class="modal-footer">
						<button class="event-btn-cancel" @onclick="CloseEditModal">Peruuta</button>
						<button class="event-btn-delete" @onclick="DeleteGameServer">Poista</button>
						<button class="event-btn-create" @onclick="SaveEditedGameServer">Tallenna muutokset</button>
					</div>
				</div>
			</div>
		</div>
	}


}


@code {
	[Parameter]
	public EventManagerViewModel ViewModel { get; set; }

	private GameServer NewGameServer { get; set; } = new GameServer();
	private bool IsGameServerModalOpen = false;
	private bool IsEditModalOpen = false;
	private GameServer? SelectedGameServer = null;

	protected override async Task OnInitializedAsync()
	{
		ViewModel.GameServers = await DB_Services.GetAllAsync<GameServer>();
	}

	private async Task CreateGameServer()
	{
		if (!string.IsNullOrWhiteSpace(NewGameServer.Name))
		{
			NewGameServer._id = ObjectId.GenerateNewId();
			DB_Services.Save(NewGameServer);
			ViewModel.GameServers = await DB_Services.GetAllAsync<GameServer>();
			NewGameServer = new GameServer();
			StateHasChanged();
			CloseGameServerModal();
		}
		else
		{
			Console.WriteLine("Pelin serverin nimi on pakollinen.");
		}
	}

	private async Task SaveEditedGameServer()
	{
		if (!string.IsNullOrWhiteSpace(SelectedGameServer.Name))
		{
			DB_Services.Save(SelectedGameServer);
			ViewModel.GameServers = await DB_Services.GetAllAsync<GameServer>();
			StateHasChanged();
			CloseEditModal();
		}
	}

	private async Task DeleteGameServer()
	{
		if (SelectedGameServer != null)
		{
			DB_Services.Delete<GameServer>(SelectedGameServer._id);
			ViewModel.GameServers = await DB_Services.GetAllAsync<GameServer>();
			CloseEditModal();
		}
	}
	private void OpenEditModal(GameServer server)
	{
		SelectedGameServer = server;
		IsEditModalOpen = true;
	}
	private void OpenGameServerModal()
	{
		IsGameServerModalOpen = true;
	}

	private void CloseGameServerModal()
	{
		IsGameServerModalOpen = false;
	}
	private void CloseEditModal()
	{
		IsEditModalOpen = false;
		SelectedGameServer = null;
	}
}
