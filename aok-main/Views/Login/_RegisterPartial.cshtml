@model AOK.ViewModels.UserRegisterViewModel
@{
    ViewData["Title"] = "AOK - Rekisteröidy";
}

<div class="container mt-3 mb-3 text-center">
    <div id="lr-button-container" class="d-flex mx-auto">
        <button data-target="Login" class="login-tab unactivated rounded-top">Kirjaudu</button>
        <button data-target="Register" class="login-tab activated rounded-top">Rekisteröidy</button>
    </div>
    <div class="row justify-content-center lr-tab rounded-bottom">
        <div class="col">
            <form asp-action="Register" asp-controller="Login" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-2 text-start mt-3">
                    <label asp-for="Username" class="form-label font-weight-bold cardcontent">Käyttäjätunnus:</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-2 text-start">
                    <label asp-for="Email" class="form-label font-weight-bold">Sähköposti:</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-2 text-start">
                    <label asp-for="Password" class="form-label font-weight-bold">Salasana:</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 text-start">
                    <label asp-for="ConfirmPassword" class="form-label font-weight-bold">Salasana uudestaan:</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="text-center text-danger mb-2">
                    <span>@ViewData["error"]</span>
                </div>

                <div class="d-flex mx-auto justify-content-lg-evenly mb-3 mt-3">
                    <button type="reset" class="event-btn-cancel">Tyhjennä</button>
                    <button type="submit" class="event-btn-create">Rekisteröidy</button>
                </div>
            </form>
        </div>
    </div>
</div>