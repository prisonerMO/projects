@model AOK.ViewModels.AccountViewModel
@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["SuccessMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}
<div class="event-panel-header-container ">
	<div class="event-panel-headers">
		<h3>Käyttäjä asetukset</h3>
	</div>
</div>

	<div class="account-container aok-nav-text-normal">
		<div class="account-content">
			<form asp-action="UpdateAccount" method="post">
				<div class="mb-3">
					<label>Käyttäjätunnus</label>
					<input asp-for="Username" type="text" class="form-control" value="@Model.Username" readonly />
				</div>

				<div class="mb-3">
					<label>Pelinimi</label>
					<input asp-for="Nickname" class="form-control" />
					<span asp-validation-for="Nickname" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Community">Yhteisö</label>
					<select asp-for="Community" class="form-control" asp-items="Model.Communities">
						<option value="">-- Valitse yhteisö --</option>
					</select>
					<span asp-validation-for="Community" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label>Etunimi</label>
					<input asp-for="FirstName" class="form-control" />
					<span asp-validation-for="FirstName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label>Sukunimi</label>
					<input asp-for="LastName" class="form-control" />
					<span asp-validation-for="LastName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label>Sähköposti</label>
					<input asp-for="Email" class="form-control" />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
				<button type="submit" class="event-btn-create">Tallenna muutokset</button>
			</form>
		</div>
		<div class="event-panel-header-container ">
			<div class="event-panel-headers">
				<h3>********</h3>
			</div>
		</div>
		<div class="account-content">		
			<button class="event-btn-modify" id="PasswordSection">
				Vaihda salasana
			</button>
			<div id="password-container"></div>
		</div>
	</div>


@section Scripts {
	<script>
			$("#PasswordSection").on("click", function () {			
			$.ajax({
				url: "/Account/_ChangePasswordPartial",
				type: "POST",
				success: function (data) {
					$("#password-container").html(data);
				},
				error: function () {
					alert("Salasanakenttien lataus epäonnistui.");
				}
			});
		});
	</script>
}